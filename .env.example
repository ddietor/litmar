# --- Modelo de lenguaje (resúmenes y revisión) ------------------------------
# Formato proveedor:modelo. Cambiar de modelo es cambiar esta línea.
# Gemini gratis: clave en https://aistudio.google.com («Get API key»). En el plan
# gratuito Google puede usar lo que envías: solo datos públicos.
LITMAR_MODELO=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
# O con una clave de la API de Anthropic (Claude Pro no incluye la API):
# LITMAR_MODELO=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Máximo de llamadas al modelo por minuto (10 por defecto, pensado para el plan
# gratuito de Gemini). 0 = sin límite.
LITMAR_LLAMADAS_POR_MINUTO=
